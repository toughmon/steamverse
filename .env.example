# Steam Web API 키 — https://steamcommunity.com/dev/apikey 에서 발급
# 이 파일을 복사해 .env 로 저장한 뒤 값을 채운다. (.env 는 git에 올라가지 않는다)
STEAM_API_KEY=

# 테스트할 계정의 SteamID64(17자리) 또는 프로필 주소의 /id/ 뒤 이름
STEAM_TEST_USER=

# ── 공개 웹 서비스 설정 (개발 중에는 비워 둬도 된다) ──
# 1이면 공개 모드: Steam 로그인한 본인 계정만 조회, STEAM_TEST_USER와 ?user= 무시
PUBLIC_MODE=
# 서비스 주소. Steam 로그인 후 돌아올 주소가 된다 (예: https://example.com)
PUBLIC_ORIGIN=
# 로그인 세션 쿠키 서명 키, 32자 이상 임의 문자열 (예: openssl rand -hex 32)
SESSION_SECRET=

# ── 배포 설정 (docs/DEPLOY.md) ──
# 리버스 프록시(HTTPS) 뒤에서 돌면 1
TRUST_PROXY=
# 캐시 폴더 (배포에서는 영구 디스크). 비우면 apps/server/.cache
CACHE_DIR=
# 운영자 연락처와 서버 위치(국가) — 정보 패널·개인정보처리방침에 표시된다
CONTACT_EMAIL=
SERVER_REGION=
# 한 사람이 하루에 새로 동기화할 수 있는 횟수 (기본 10)
USER_DAILY_SYNCS=
